{
  "name": "nukpos",
  "version": "1.0.0",
  "description": "Nuk_POS — Sistema de Gestão Integrado",
  "main": "server/app.js",
  "scripts": {
    "start": "node scripts/start.js",
    "dev": "nodemon server/app.js",
    "test": "jest --selectProjects unit --forceExit",
    "test:watch": "jest --watch",
    "test:coverage": "jest --selectProjects unit --coverage --forceExit",
    "migrate": "node-pg-migrate up --migrations-dir migrations",
    "migrate:down": "node-pg-migrate down --migrations-dir migrations",
    "migrate:create": "node-pg-migrate create --migrations-dir migrations",
    "test:unit": "jest --selectProjects unit --forceExit",
    "test:integration": "jest --selectProjects integration --runInBand --forceExit",
    "test:all": "jest --runInBand --forceExit",
    "start:nomigrate": "node server/app.js"
  },
  "jest": {
    "testTimeout": 15000,
    "verbose": true,
    "projects": [
      {
        "displayName": "unit",
        "testEnvironment": "node",
        "setupFilesAfterEnv": [
          "<rootDir>/tests/setup.js"
        ],
        "testMatch": [
          "<rootDir>/tests/*.test.js"
        ]
      },
      {
        "displayName": "integration",
        "testEnvironment": "node",
        "globalSetup": "<rootDir>/tests/integration/globalSetup.js",
        "globalTeardown": "<rootDir>/tests/integration/globalTeardown.js",
        "setupFilesAfterEnv": [
          "<rootDir>/tests/integration/setup.js"
        ],
        "testMatch": [
          "<rootDir>/tests/integration/*.int.test.js"
        ]
      }
    ]
  },
  "dependencies": {
    "@sentry/node": "^11.10.0",
    "bcryptjs": "^2.4.3",
    "cors": "^2.8.5",
    "dotenv": "^18.0.9",
    "express": "^4.18.2",
    "express-rate-limit": "^7.1.5",
    "helmet": "^7.1.0",
    "jsonwebtoken": "^9.0.2",
    "node-pg-migrate": "^9.0.0",
    "pdfkit": "^0.20.2",
    "pg": "^8.11.3",
    "pino": "^10.4.0",
    "pino-http": "^11.0.0",
    "qrcode": "^1.5.4",
    "socket.io": "^4.6.2",
    "swagger-jsdoc": "^6.2.8",
    "swagger-ui-express": "^5.0.1",
    "twilio": "^6.2.0",
    "uuid": "^9.0.1"
  },
  "devDependencies": {
    "jest": "^30.5.2",
    "nodemon": "^3.0.3",
    "supertest": "^7.3.1"
  },
  "engines": {
    "node": ">=18.0.0"
  }
}
