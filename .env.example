# Nuk_POS — Variáveis de Ambiente
# Copiar para .env e preencher os valores reais

# ── Base de Dados PostgreSQL (Render fornece automaticamente) ──
DATABASE_URL=postgresql://nukpos_user:PASSWORD@HOST:5432/nukpos

# ── JWT ───────────────────────────────────────────────────────
JWT_SECRET=alterar_para_um_segredo_longo_e_aleatorio_minimo_32_chars

# ── Ambiente ──────────────────────────────────────────────────
NODE_ENV=production
PORT=3000
